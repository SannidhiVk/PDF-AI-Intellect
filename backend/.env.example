# ═══════════════════════════════════════════════════════════════════════════
# backend/.env.example
# -----------------------------------------------------------------------------
# Copy this file to backend/.env and fill in real values.
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored — never commit real keys.
# ═══════════════════════════════════════════════════════════════════════════

# ── Groq Cloud (REQUIRED) ─────────────────────────────────────────────────
# Used for embeddings (nomic-embed-text-v1_5), summaries, and RAG chat.
# Get your key at: https://console.groq.com → API Keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EMBEDDING_MODEL=nomic-embed-text-v1_5

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────
# App will refuse to start if SUPABASE_URL or SUPABASE_KEY is missing.
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Frontend URL (REQUIRED for production CORS) ───────────────────────────
# Set this to your Vercel deployment URL so the backend allows cross-origin
# requests from the frontend. localhost:3000 is always allowed automatically.
FRONTEND_URL=https://your-app.vercel.app

# ── Brevo (REQUIRED for email invite feature) ─────────────────────────────
# Free plan: 300 emails/day. Sign up at https://brevo.com
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=PDF Intellect
